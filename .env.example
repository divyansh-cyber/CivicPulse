# Copy to apps/api/.env and fill in values
MONGODB_URI=mongodb://localhost:27017/civicpulse
REDIS_URL=redis://localhost:6379
PORT=4000
JWT_SECRET=change_me_to_something_long_and_random
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# SLA hours per tier (how long before auto-escalation)
SLA_HOURS_LOCALITY=48
SLA_HOURS_COLONY=72
SLA_HOURS_MUNICIPALITY=120
SLA_HOURS_CITY=168

# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXTAUTH_SECRET=change_me

# Copy to services/ai-moderation/.env
GEMINI_API_KEY=your_gemini_api_key_here

# Copy to workers/*/.env
MONGODB_URI=mongodb://localhost:27017/civicpulse
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:4000
