# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
packages/*/node_modules/
apps/*/node_modules/
services/*/venv/
services/*/__pycache__/
venv/
env/
__pycache__/
*.pyc

# testing
/coverage
apps/*/coverage
packages/*/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/

# production
/build
apps/*/build
packages/*/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env
*.env
# (do not ignore .env.example)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / Editor
.idea/
.vscode/
.vs/
*.swp
*.swo

# system generated
.system_generated/
